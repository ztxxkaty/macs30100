    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Fit model (your code)\n",
    "model = smf.ols(formula=formula, data=df)\n",
    "result = model.fit()\n",
    "\n",
    "def interaction_plot(result, df, x=\"mem_A\", z=\"sim_AC\", title=None):\n",
    "    # grid for x\n",
    "    x_grid = np.linspace(df[x].min(), df[x].max(), 80)\n",
    "\n",
    "    # choose three representative z levels\n",
    "    z_levels = {\n",
    "        \"low (25%)\": df[z].quantile(0.25),\n",
    "        \"mid (50%)\": df[z].quantile(0.50),\n",
    "        \"high (75%)\": df[z].quantile(0.75),\n",
    "    }\n",
    "\n",
    "    # keep other vars fixed (typical values)\n",
    "    base = {\n",
    "        \"mem_A\": df[\"mem_A\"].mean(),\n",
    "        \"mem_B\": df[\"mem_B\"].mean(),\n",
    "        \"sim_AC\": df[\"sim_AC\"].mean(),\n",
    "        \"sim_BC\": df[\"sim_BC\"].mean(),\n",
    "        \"semantic_similarity\": df[\"semantic_similarity\"].mean(),\n",
    "        \"category\": df[\"category\"].mode().iloc[0],  # pick most common category\n",
    "    }\n",
    "\n",
    "    plt.figure()\n",
    "    for lab, z_val in z_levels.items():\n",
    "        tmp = pd.DataFrame({k: [v]*len(x_grid) for k, v in base.items()})\n",
    "        tmp[x] = x_grid\n",
    "        tmp[z] = z_val\n",
    "        yhat = result.predict(tmp)\n",
    "        plt.plot(x_grid, yhat, label=f\"{z} = {lab}\")\n",
    "\n",
    "    plt.xlabel(x)\n",
    "    plt.ylabel(\"Predicted mem_C\")\n",
    "    plt.title(title or f\"Interaction: {x} × {z}\")\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "\n",
    "interaction_plot(result, df, x=\"mem_A\", z=\"sim_AC\", title=\"mem_A × sim_AC\")\n",
    "interaction_plot(result, df, x=\"mem_B\", z=\"sim_BC\", title=\"mem_B × sim_BC\")"
   ]
  },
