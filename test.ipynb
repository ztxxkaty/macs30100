    "import matplotlib.pyplot as plt\n",
    "\n",
    "def heatmap_pred(result, df, x=\"mem_A\", z=\"sim_AC\", bins=40, title=None):\n",
    "    x_vals = np.linspace(df[x].min(), df[x].max(), bins)\n",
    "    z_vals = np.linspace(df[z].min(), df[z].max(), bins)\n",
    "\n",
    "    base = {\n",
    "        \"mem_A\": df[\"mem_A\"].mean(),\n",
    "        \"mem_B\": df[\"mem_B\"].mean(),\n",
    "        \"sim_AC\": df[\"sim_AC\"].mean(),\n",
    "        \"sim_BC\": df[\"sim_BC\"].mean(),\n",
    "        \"semantic_similarity\": df[\"semantic_similarity\"].mean(),\n",
    "        \"category\": df[\"category\"].mode().iloc[0],\n",
    "    }\n",
    "\n",
    "    grid = []\n",
    "    for xv in x_vals:\n",
    "        for zv in z_vals:\n",
    "            row = base.copy()\n",
    "            row[x] = xv\n",
    "            row[z] = zv\n",
    "            grid.append(row)\n",
    "\n",
    "    grid = pd.DataFrame(grid)\n",
    "    yhat = result.predict(grid).values.reshape(bins, bins)\n",
    "\n",
    "    plt.figure()\n",
    "    plt.imshow(yhat, origin=\"lower\", aspect=\"auto\",\n",
    "               extent=[x_vals.min(), x_vals.max(), z_vals.min(), z_vals.max()])\n",
    "    plt.colorbar(label=\"Predicted mem_C\")\n",
    "    plt.xlabel(x)\n",
    "    plt.ylabel(z)\n",
    "    plt.title(title or f\"Predicted mem_C over {x} and {z}\")\n",
    "    plt.show()\n",
    "\n",
    "heatmap_pred(result, df, x=\"mem_A\", z=\"sim_AC\", title=\"Heatmap: mem_A × sim_AC\")\n",
    "heatmap_pred(result, df, x=\"mem_B\", z=\"sim_BC\", title=\"Heatmap: mem_B × sim_BC\")"
   ]
  },
