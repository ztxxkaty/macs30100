    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def plot_effect_of_simAC_by_memA(result, df, bins=80, add_ci=True):\n",
    "    # x grid for sim_AC\n",
    "    x_grid = np.linspace(df[\"sim_AC\"].min(), df[\"sim_AC\"].max(), bins)\n",
    "\n",
    "    # choose three representative mem_A levels\n",
    "    memA_levels = {\n",
    "        \"low mem_A (25%)\": df[\"mem_A\"].quantile(0.25),\n",
    "        \"mid mem_A (50%)\": df[\"mem_A\"].quantile(0.50),\n",
    "        \"high mem_A (75%)\": df[\"mem_A\"].quantile(0.75),\n",
    "    }\n",
    "\n",
    "    # hold other predictors fixed at typical values\n",
    "    base = {\n",
    "        \"mem_A\": df[\"mem_A\"].mean(),\n",
    "        \"mem_B\": df[\"mem_B\"].mean(),\n",
    "        \"sim_AC\": df[\"sim_AC\"].mean(),\n",
    "        \"sim_BC\": df[\"sim_BC\"].mean(),\n",
    "        \"semantic_similarity\": df[\"semantic_similarity\"].mean(),\n",
    "        \"category\": df[\"category\"].mode().iloc[0],  # most common category\n",
    "    }\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    for lab, memA_val in memA_levels.items():\n",
    "        tmp = pd.DataFrame({k: [v]*len(x_grid) for k, v in base.items()})\n",
    "        tmp[\"mem_A\"] = memA_val\n",
    "        tmp[\"sim_AC\"] = x_grid\n",
    "\n",
    "        if add_ci:\n",
    "            pred = result.get_prediction(tmp).summary_frame(alpha=0.05)\n",
    "            plt.plot(x_grid, pred[\"mean\"], label=lab)\n",
    "            plt.fill_between(x_grid, pred[\"mean_ci_lower\"], pred[\"mean_ci_upper\"], alpha=0.2)\n",
    "        else:\n",
    "            yhat = result.predict(tmp)\n",
    "            plt.plot(x_grid, yhat, label=lab)\n",
    "\n",
    "    plt.xlabel(\"sim_AC\")\n",
    "    plt.ylabel(\"Predicted mem_C\")\n",
    "    plt.title(\"Effect of sim_AC on mem_C at different mem_A levels\")\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "\n",
    "def plot_effect_of_simBC_by_memB(result, df, bins=80, add_ci=True):\n",
    "    # x grid for sim_BC\n",
    "    x_grid = np.linspace(df[\"sim_BC\"].min(), df[\"sim_BC\"].max(), bins)\n",
    "\n",
    "    # choose three representative mem_A levels\n",
    "    memB_levels = {\n",
    "        \"low mem_B (25%)\": df[\"mem_B\"].quantile(0.25),\n",
    "        \"mid mem_B (50%)\": df[\"mem_B\"].quantile(0.50),\n",
    "        \"high mem_B (75%)\": df[\"mem_B\"].quantile(0.75),\n",
    "    }\n",
    "\n",
    "    # hold other predictors fixed at typical values\n",
    "    base = {\n",
    "        \"mem_A\": df[\"mem_A\"].mean(),\n",
    "        \"mem_B\": df[\"mem_B\"].mean(),\n",
    "        \"sim_AC\": df[\"sim_AC\"].mean(),\n",
    "        \"sim_BC\": df[\"sim_BC\"].mean(),\n",
    "        \"semantic_similarity\": df[\"semantic_similarity\"].mean(),\n",
    "        \"category\": df[\"category\"].mode().iloc[0],  # most common category\n",
    "    }\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    for lab, memB_val in memB_levels.items():\n",
    "        tmp = pd.DataFrame({k: [v]*len(x_grid) for k, v in base.items()})\n",
    "        tmp[\"mem_B\"] = memB_val\n",
    "        tmp[\"sim_BC\"] = x_grid\n",
    "\n",
    "        if add_ci:\n",
    "            pred = result.get_prediction(tmp).summary_frame(alpha=0.05)\n",
    "            plt.plot(x_grid, pred[\"mean\"], label=lab)\n",
    "            plt.fill_between(x_grid, pred[\"mean_ci_lower\"], pred[\"mean_ci_upper\"], alpha=0.2)\n",
    "        else:\n",
    "            yhat = result.predict(tmp)\n",
    "            plt.plot(x_grid, yhat, label=lab)\n",
    "\n",
    "    plt.xlabel(\"sim_BC\")\n",
    "    plt.ylabel(\"Predicted mem_C\")\n",
    "    plt.title(\"Effect of sim_BC on mem_C at different mem_A levels\")\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "\n",
    "# usage (after you fit result = model.fit())\n",
    "plot_effect_of_simAC_by_memA(result, df, add_ci=True)\n",
    "plot_effect_of_simBC_by_memB(result, df, add_ci=True)"
   ]
