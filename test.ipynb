    "        color=colors[pretty],\n",
    "        label=pretty\n",
    "    )\n",
    "\n",
    "# 参考线 x=0\n",
    "ax.axvline(0, linewidth=1.5)\n",
    "\n",
    "# 轴与标题\n",
    "ax.set_yticks([y_pos[g] for g in y_order])\n",
    "ax.set_yticklabels(y_order, fontsize=12)\n",
    "ax.set_xlabel(\"Coefficient (± 95% CI)\", fontsize=12)\n",
    "ax.set_title(\"Key predictors of mem(C) without min_mem\", fontsize=14)\n",
    "\n",
    "# 图例放右下角，像示例图\n",
    "ax.legend(loc=\"lower right\", frameon=True)\n",
    "\n",
    "ax.grid(False)\n",
    "ax.set_ylim(-0.6, len(y_order)-0.4)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
