    "import statsmodels.formula.api as smf\n",
    "\n",
    "formula = \"\"\"\n",
    "    mem_C ~ mem_A\n",
    "            + mem_B\n",
    "            + sim_AC \n",
    "            + sim_BC \n",
    "            + semantic_similarity\n",
    "            + category \n",
    "            + mem_A * sim_AC\n",
    "            + mem_B * sim_BC \n",
    "    \"\"\"\n",
    "\n",
    "model = smf.ols(formula=formula, data=df)\n",
    "result = model.fit()\n",
    "\n",
    "print(result.summary())"
   ]
