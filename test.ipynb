    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# 2) predictors\n",
    "display_vars = [\n",
    "    (\"mem_A\", \"mem_A: max_mem)\"),\n",
    "    (\"mem_B\", \"mem_B: min_mem\"),\n",
    "    (\"sim_AC\", \"sim_AC: (pixel)similarity of AC\"),\n",
    "    (\"sim_BC\", \"sim_BC: (pixel)similarity of BC\"),\n",
    "    (\"semantic_similarity\", \"semantic_similarity of AB\")\n",
    "]\n",
    "\n",
    "# 3) 拟合并收集系数 & 95% CI\n",
    "def fit_and_collect(data, label):\n",
    "    res = smf.ols(formula=formula, data=data).fit()\n",
    "    rows = []\n",
    "    for var, pretty in display_vars:\n",
    "        if var not in res.params.index:\n",
    "            continue\n",
    "        coef = float(res.params[var])\n",
    "        se = float(res.bse[var])\n",
    "        lo = coef - 1.96 * se\n",
    "        hi = coef + 1.96 * se\n",
    "        rows.append({\n",
    "            \"group\": label,\n",
    "            \"var\": var,\n",
    "            \"label\": pretty,\n",
    "            \"coef\": coef,\n",
    "            \"lo\": lo,\n",
    "            \"hi\": hi\n",
    "        })\n",
    "    return rows\n",
    "\n",
    "rows = []\n",
    "\n",
    "# whole\n",
    "rows += fit_and_collect(df, \"whole\")\n",
    "\n",
    "# by category\n",
    "group_order = [\"HD\", \"HS\", \"LD\", \"LS\"]\n",
    "for g in group_order:\n",
    "    rows += fit_and_collect(df[df[\"category\"] == g], g)\n",
    "\n",
    "plot_df = pd.DataFrame(rows)\n",
    "\n",
    "# 4) 画森林图（点 + 误差条）\n",
    "#    每个 group 有多条 predictor，做水平错位（dodge）\n",
    "fig, ax = plt.subplots(figsize=(14, 10), dpi=200)\n",
    "\n",
    "# y 轴顺序：\n",
    "y_order = [\"LS\", \"LD\", \"HS\", \"HD\", \"whole\"]\n",
    "y_pos = {g: i for i, g in enumerate(y_order)}\n",
    "\n",
    "# 给每条 predictor 一个固定的 y 偏移，避免重叠\n",
    "offsets = np.linspace(-0.25, 0.25, num=len(display_vars))\n",
    "\n",
    "# 颜色/标记：\n",
    "colors = {\n",
    "    \"mem_A: max_mem)\": \"C0\",\n",
    "    \"mem_B: min_mem\": \"C1\",\n",
    "    \"sim_AC: (pixel)similarity of AC\": \"C2\",\n",
    "    \"sim_BC: (pixel)similarity of BC\": \"C3\",\n",
    "    \"semantic_similarity of AB\": \"C4\"\n",
    "}\n",
    "markers = {\n",
    "    \"mem_A: max_mem)\": \"o\",\n",
    "    \"mem_B: min_mem\": \"o\",\n",
    "    \"sim_AC: (pixel)similarity of AC\": \"o\",\n",
    "    \"sim_BC: (pixel)similarity of BC\": \"o\",\n",
    "    \"semantic_similarity of AB\": \"o\"\n",
    "}\n",
    "\n",
    "# 画每个 predictor\n",
    "for j, (_, pretty) in enumerate(display_vars):\n",
    "    sub = plot_df[plot_df[\"label\"] == pretty].copy()\n",
    "    # y 坐标 + dodge\n",
    "    ys = np.array([y_pos[g] for g in sub[\"group\"]]) + offsets[j]\n",
    "    xs = sub[\"coef\"].to_numpy()\n",
    "    xerr_low = xs - sub[\"lo\"].to_numpy()\n",
    "    xerr_high = sub[\"hi\"].to_numpy() - xs\n",
    "    ax.errorbar(\n",
    "        xs, ys,\n",
    "        xerr=[xerr_low, xerr_high],\n",
    "        fmt=markers[pretty],\n",
    "        capsize=4,\n",
    "        elinewidth=2,\n",
    "        markersize=7,\n",
    "        color=colors[pretty],\n",
    "        label=pretty\n",
    "    )\n",
    "\n",
    "# 参考线 x=0\n",
    "ax.axvline(0, linewidth=1.5)\n",
    "\n",
    "# 轴与标题\n",
    "ax.set_yticks([y_pos[g] for g in y_order])\n",
    "ax.set_yticklabels(y_order, fontsize=12)\n",
    "ax.set_xlabel(\"Coefficient (± 95% CI)\", fontsize=12)\n",
    "ax.set_title(\"Key predictors of mem(C) without min_mem\", fontsize=14)\n",
    "\n",
    "# 图例放右下角，像示例图\n",
    "ax.legend(loc=\"lower right\", frameon=True)\n",
    "\n",
    "ax.grid(False)\n",
    "ax.set_ylim(-0.6, len(y_order)-0.4)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
